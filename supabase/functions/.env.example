# Variables de las Edge Functions para correrlas en local:
#   copia este archivo como supabase/functions/.env (no se sube a git) y llena los valores;
#   npx supabase functions serve siigo --env-file supabase/functions/.env
# En producción NO se usa este archivo: se cargan como secretos de Supabase
#   npx supabase secrets set --env-file supabase/functions/.env

# Siigo API
SIIGO_API_URL=https://api.siigo.com
SIIGO_PARTNER_ID=ManoloRoastery
SIIGO_USUARIO=
SIIGO_LLAVE=

# Los ids de la cotización (comprobante, vendedor, productos) y los datos para crear clientes
# ya no van aquí: se editan en la app, en Configuración › Cotización en Siigo.
